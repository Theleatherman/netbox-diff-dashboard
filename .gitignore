# Environment and secrets
.env
.env.*
!.env.example

# Virtual environments
.venv/
venv/
env/

# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class

# Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/
.tox/
.nox/

# Test and coverage outputs
.coverage
.coverage.*
coverage.xml
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Logs and runtime files
*.log
*.pid

# Databases and local app data
*.db
*.sqlite
*.sqlite3

# Editors and OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Archives and backups
*.zip
*.tar
*.gz
*.bz2
*.7z
*.bak

# Local SSL material (keep setup script under version control)
ssl/*.crt
ssl/*.csr
ssl/*.key
ssl/*.pem
ssl/*.pfx
ssl/*.p12
